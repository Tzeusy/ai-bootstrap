#!/usr/bin/env bash
# user-run: __SLUG__
# Generated by Claude (user-run skill). The owner runs this; Claude reads the logs.
# Edit only the PAYLOAD heredoc. Everything else is the fixed harness.
#
#   Run:      bash __SLUG_DIR__/run.sh
#   Logs:     __SLUG_DIR__/<RUN_ID>.log, latest.log -> newest
#   Exit:     __SLUG_DIR__/latest.exit (exit code; absent while running)
#   Outputs:  __SLUG_DIR__/artifacts/<RUN_ID>/ ($ARTIFACTS), artifacts/latest -> newest
#
# The body is one function, parsed whole before it runs, so editing this file
# during a run cannot change what the run executes.
[ -n "${BASH_VERSION:-}" ] || exec /usr/bin/env bash "$0" "$@"

main() {
set -uo pipefail

RUN_USER="${USER_TO_IMPERSONATE:-tze}"
SLUG_DIR="__SLUG_DIR__"

die() { echo "user-run: $*" >&2; exit 2; }

umask 002
[ -d "$SLUG_DIR" ] && [ -w "$SLUG_DIR" ] || die "cannot write $SLUG_DIR as $(id -un) (check group membership: id)"
getent passwd "$RUN_USER" >/dev/null || die "no such user: $RUN_USER"
INVOKER="$(id -un)"
if [ "$INVOKER" != "$RUN_USER" ] && [ ! -t 0 ]; then
  die "su needs a terminal; run this from a real terminal, or as $RUN_USER directly"
fi

# One run per slug at a time. fd 9 holds the lock for the whole run and is
# closed for the payload and tee, so background children cannot keep it held.
# A read fd is enough for flock, whoever created the lock file.
[ -e "$SLUG_DIR/.lock" ] || : >> "$SLUG_DIR/.lock"
exec 9< "$SLUG_DIR/.lock" || die "cannot open $SLUG_DIR/.lock"
flock -n 9 || die "another run of __SLUG__ is in progress"

RUN_ID="$(date +%Y%m%d%H%M%S)"
while [ -e "$SLUG_DIR/$RUN_ID.log" ]; do sleep 1; RUN_ID="$(date +%Y%m%d%H%M%S)"; done
LOG="$SLUG_DIR/$RUN_ID.log"
ARTIFACTS="$SLUG_DIR/artifacts/$RUN_ID"
PAYLOAD_FILE="$SLUG_DIR/payload.$RUN_ID.sh"

mkdir -p "$ARTIFACTS" || die "cannot create $ARTIFACTS"
: > "$LOG" || die "cannot write $LOG"

# ---------------------------------------------------------------- PAYLOAD
# Runs as $RUN_USER under that user's interactive shell config (PATH from
# ~/.zshrc etc), stdin from /dev/null (sudo still prompts on the terminal).
# Available: $ARTIFACTS (this run's dir), $SLUG_DIR, $RUN_ID. Keep `set -e`.
# Never print secret values; this log is read back by Claude.
# No line may be exactly PAYLOAD: it ends the heredoc.
cat > "$PAYLOAD_FILE" <<'PAYLOAD' || die "cannot write $PAYLOAD_FILE (disk full?)"
set -euo pipefail
shopt -s inherit_errexit
echo "payload: replace me"
PAYLOAD
# ---------------------------------------------------------------- /PAYLOAD
chmod 0660 "$PAYLOAD_FILE" || die "cannot chmod $PAYLOAD_FILE"
bash -n "$PAYLOAD_FILE" || die "payload has a syntax error"

rm -f "$SLUG_DIR/latest.exit"
ln -sfn "$RUN_ID.log" "$SLUG_DIR/latest.log"
ln -sfn "$RUN_ID" "$SLUG_DIR/artifacts/latest"

{
  finish() {
    # Files first: if the terminal hung up, tee is gone and echo dies of SIGPIPE.
    echo "$1" > "$SLUG_DIR/$RUN_ID.exit"
    ln -sfn "$RUN_ID.exit" "$SLUG_DIR/latest.exit"
    echo "== end=$(date -Is) exit=$1"
  }
  # Signals are noted, not acted on: the child gets them too, and its own exit
  # code (which may come from its own cleanup trap) is what gets recorded.
  sig=""
  trap 'sig=INT' INT
  trap 'sig=TERM' TERM
  trap 'sig=HUP' HUP
  echo "== user-run __SLUG__ run=$RUN_ID as=$RUN_USER invoked_by=$INVOKER host=$(hostname) start=$(date -Is)"
  # The .started marker proves authentication succeeded and the payload began.
  inner="umask 002; export ARTIFACTS='$ARTIFACTS' SLUG_DIR='$SLUG_DIR' RUN_ID='$RUN_ID'"
  inner+=" PAGER=cat GIT_PAGER=cat SYSTEMD_PAGER=cat NO_COLOR=1;"
  inner+=" : > '$SLUG_DIR/$RUN_ID.started'; exec bash '$PAYLOAD_FILE' </dev/null"
  if [ "$INVOKER" = "$RUN_USER" ]; then
    "${SHELL:-/bin/bash}" -ic "$inner" </dev/null 9<&-
  else
    # su prompts for $RUN_USER's password on this terminal. --pty gives the
    # payload a controlling terminal: plain `su -c` starts a new session
    # without one, and sudo inside the payload then cannot prompt.
    su --pty - "$RUN_USER" -c "exec \"\${SHELL:-/bin/bash}\" -ic \"$inner\" </dev/null" 9<&-
  fi
  rc=$?
  finish "$rc"
  [ -z "$sig" ] || echo "== signal: $sig"
  exit "$rc"
} 2>&1 | tee -ai "$LOG" 9<&-
exit "${PIPESTATUS[0]}"
}
main "$@"
exit
