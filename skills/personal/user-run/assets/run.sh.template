#!/usr/bin/env bash
# user-run: __SLUG__
# Generated by Claude (user-run skill). The owner runs this; Claude reads the logs.
# Edit only the PAYLOAD heredoc. Everything else is the fixed harness.
#
#   Run:      bash /home/orca/.tmp/__SLUG__/run.sh
#   Logs:     /home/orca/.tmp/__SLUG__/<YYYYmmddHHMMSS>.log, latest.log -> newest
#   Exit:     /home/orca/.tmp/__SLUG__/latest.exit (payload exit code)
#   Outputs:  /home/orca/.tmp/__SLUG__/artifacts/  ($ARTIFACTS inside the payload)
set -uo pipefail

RUN_USER="${USER_TO_IMPERSONATE:-tze}"
SLUG_DIR="/home/orca/.tmp/__SLUG__"
RUN_ID="$(date +%Y%m%d%H%M%S)"
LOG="$SLUG_DIR/$RUN_ID.log"
ARTIFACTS="$SLUG_DIR/artifacts"
PAYLOAD_FILE="$SLUG_DIR/payload.$RUN_ID.sh"

umask 002
mkdir -p "$ARTIFACTS"
chmod 2770 "$SLUG_DIR" "$ARTIFACTS" 2>/dev/null || true
: > "$LOG"
ln -sfn "$RUN_ID.log" "$SLUG_DIR/latest.log"
rm -f "$SLUG_DIR/latest.exit"

# ---------------------------------------------------------------- PAYLOAD
# Runs as $RUN_USER under that user's interactive shell config (PATH from
# ~/.zshrc etc). Available: $ARTIFACTS, $SLUG_DIR, $RUN_ID. Keep `set -e`.
# Never print secret values; this log is read back by Claude.
cat > "$PAYLOAD_FILE" <<'PAYLOAD'
set -euo pipefail
echo "payload: replace me"
PAYLOAD
# ---------------------------------------------------------------- /PAYLOAD
chmod 0660 "$PAYLOAD_FILE"

{
  echo "== user-run __SLUG__ run=$RUN_ID as=$RUN_USER invoked_by=$(id -un) host=$(hostname) start=$(date -Is)"
  export ARTIFACTS SLUG_DIR RUN_ID
  inner="umask 002; export ARTIFACTS='$ARTIFACTS' SLUG_DIR='$SLUG_DIR' RUN_ID='$RUN_ID'; bash '$PAYLOAD_FILE'"
  if [ "$(id -un)" = "$RUN_USER" ]; then
    "${SHELL:-/bin/bash}" -ic "$inner" </dev/null
  else
    # su prompts for $RUN_USER's password on the controlling terminal.
    su - "$RUN_USER" -c "exec \"\${SHELL:-/bin/bash}\" -ic \"$inner\""
  fi
  rc=$?
  echo "== end=$(date -Is) exit=$rc"
  echo "$rc" > "$SLUG_DIR/latest.exit"
  exit "$rc"
} 2>&1 | tee -a "$LOG"
exit "${PIPESTATUS[0]}"
